# 必填：模型 API Key（本文件复制为 .env；.env 已被 git 忽略）
# DEEPSEEK_API_KEY 供 agent.jsonc 的 "{env:DEEPSEEK_API_KEY}" 插值读取；
# KURUMI_API_KEY 由 envSource 映射为 api_key，优先级更高。
# 若在配置文件中删除 api_key，则需要提供 KURUMI_API_KEY（注意拼写）。
DEEPSEEK_API_KEY=sk-your-key
KURUMI_API_KEY=sk-your-key

# 可选：覆盖 agent.jsonc 中的同名字段
# KURUMI_MODEL=deepseek-flash
# KURUMI_BASE_URL=https://api.deepseek.com
# KURUMI_LOG_LEVEL=debug
# KURUMI_MAX_STEPS=4
# KURUMI_THINKING=true
# KURUMI_THINKING_BUDGET_TOKENS=2048
# KURUMI_REASONING_EFFORT=high
