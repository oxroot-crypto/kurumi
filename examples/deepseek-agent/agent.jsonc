{
  // 真实环境验证配置；环境变量 KURUMI_* 会覆盖同名字段。
  // api_key 支持 {env:NAME} 形式，直接读取 DEEPSEEK_API_KEY；KURUMI_API_KEY 的优先级更高。
  "api_key": "{env:DEEPSEEK_API_KEY}",
  "api_format": "openai",
  "model": "deepseek-chat",
  "base_url": "https://api.deepseek.com",
  "temperature": 0.2,
  "max_steps": 4,
  "max_output_tokens": 1024,
  "thinking": true,
  "thinking_budget_tokens": 2048,
  "reasoning_effort": "medium",
  "log_level": "info",
  "system": "你是 Kurumi Agent SDK 的验证助手。需要工具时直接调用工具，回答简洁准确。",
}
